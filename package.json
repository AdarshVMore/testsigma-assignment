{
  "name": "testsigma-assignment",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/self-healing/tsconfig.json && tsc --noEmit -p packages/test-reporter/tsconfig.json",
    "test": "bun test",
    "test:self-healing": "bun test packages/self-healing",
    "test:reporter": "bun test packages/test-reporter",
    "demo:self-healing": "bunx playwright test --config packages/self-healing/playwright.config.ts",
    "demo:reporter": "bun run examples/reporter/generate.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@playwright/test": "^1.62.1",
    "typescript": "^5"
  }
}
